# Stage 1: Build the backend and generate prisma client
FROM node:20-alpine AS builder

WORKDIR /app

# Install native dependencies required by Prisma in Alpine Linux
RUN apk add --no-cache openssl libc6-compat

# Copy package files
COPY package*.json ./
COPY tsconfig.base.json ./
COPY nx.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy the source code and Prisma schema
COPY apps/backend ./apps/backend
COPY libs ./libs
COPY prisma ./prisma

# Generate Prisma client first (needed for compilation as TS types depend on it)
RUN npx prisma generate

# Build the backend application
RUN npx nx build backend --configuration=production

# Stage 2: Runtime image
FROM node:20-alpine AS runner

WORKDIR /app

# Install native dependencies required by Prisma in Alpine Linux
RUN apk add --no-cache openssl libc6-compat

# Copy custom package.json generated by webpack
COPY --from=builder /app/dist/apps/backend/package.json ./package.json
COPY --from=builder /app/prisma ./prisma

# Install production dependencies
RUN npm install --omit=dev --legacy-peer-deps

# Copy generated Prisma Client directly from the builder stage
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Copy built backend files (entire directory to include any assets)
COPY --from=builder /app/dist/apps/backend ./dist/apps/backend
COPY add-system-admin.js ./add-system-admin.js

# Install prisma CLI for running migrations at startup (pinned to matching workspace version)
RUN npm install prisma@5.22.0 --no-save --legacy-peer-deps

EXPOSE 3000

# Set entrypoint to run migrations, seed, register admin, and start the backend NestJS app
CMD ["sh", "-c", "npx prisma migrate deploy && node prisma/seed.js && node add-system-admin.js admin && node dist/apps/backend/main.js"]
